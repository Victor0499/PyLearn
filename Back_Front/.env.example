# ──────────────────────────────────────────────────────────
# INSTRUCCIONES
# ──────────────────────────────────────────────────────────
# 1. Copia este archivo y renómbralo a ".env.local"
# 2. Rellena cada variable con los valores reales de tu proyecto
# 3. NUNCA subas el archivo .env.local a GitHub
# ──────────────────────────────────────────────────────────

# Supabase (lo encuentras en: Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clave secreta para firmar los tokens JWT de la aplicación (puedes inventar cualquier string largo y aleatorio)
JWT_SECRET=

# Configuración de hot-reload para Docker (no cambiar)
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000

# URL pública de la aplicación (para construir links de recuperación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nodemailer: Configuración del servidor SMTP para envío de correos
# Puedes usar Gmail: activa "Contraseñas de aplicaciones" en tu cuenta Google
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion
EMAIL_FROM="PyLearn <tu_correo@gmail.com>"
